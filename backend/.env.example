
# DermTrace Backend — Environment Variables
# Copy this file to .env and fill in your values

# App
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-32-char-string-in-production

# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://dermatrace:dermatrace@localhost:5432/dermatrace

# CORS — add your Expo dev URL here
CORS_ORIGINS=["http://localhost:19006","http://localhost:8081","exp://localhost:8081"]

# AI Service (optional — uses mock if empty)
AI_SERVICE_URL=
